  "patterns": [
    {
      "id": "workstation-path",
      "description": "workstation home-directory paths",
      "source": "(?:/Users/|/home/[A-Za-z0-9._-]+/|[A-Za-z]:\\\\Users\\\\|/private/var/folders/)",
      "flags": "i",
      "scope": "both"
    },
    {
      "id": "private-ipv4",
      "description": "private IPv4 address ranges",
      "source": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3})\\b",
      "flags": "",
      "scope": "both"
    },
    {
      "id": "loopback-host",
      "description": "loopback and wildcard addresses",
      "source": "(?:\\b127\\.0\\.0\\.1\\b|\\blocalhost\\b|\\b0\\.0\\.0\\.0\\b|\\b::1\\b)",
      "flags": "i",
      "scope": "both"
    },
    {
      "id": "host-with-port",
      "description": "a host name followed by a port",
      "source": "\\b(?:[a-z0-9-]+\\.)+(?:com|net|org|io|dev|app|cloud|workers|example|local|internal|home|lan|test|site|page|sh|gg|ai|co|uk|us|xyz):\\d{2,5}\\b",
      "flags": "i",
      "scope": "both"
    },
    {
      "id": "workers-subdomain",
      "description": "workers.dev hostnames",
      "source": "\\bworkers\\.dev\\b",
      "flags": "i",
      "scope": "both"
    },
    {
      "id": "hosting-dashboard",
      "description": "hosting dashboard URLs",
      "source": "\\bdash\\.cloudflare\\.com\\b",
      "flags": "i",
      "scope": "both"
    },
    {
      "id": "drive-folder",
      "description": "Drive host links",
      "source": "\\bdrive\\.google\\.com\\b",
      "flags": "i",
      "scope": "both"
    },
    {
      "id": "drive-file",
      "description": "Docs links that address a file by identifier",
      "source": "docs\\.google\\.com/[^\\s)<>]*/d/",
      "flags": "i",
      "scope": "both"
    },
    {
      "id": "hex32",
      "description": "a bare 32-character hex identifier",
      "source": "(?<![0-9a-f])[0-9a-f]{32}(?![0-9a-f])",
      "flags": "i",
      "scope": "both"
    },
    {
      "id": "secret-openai",
      "description": "API key shapes",
      "source": "\\bsk-[A-Za-z0-9_-]{20,}",
      "flags": "",
      "scope": "both"
    },
    {
      "id": "secret-github",
      "description": "GitHub token shapes",
      "source": "\\b(?:ghp_|gho_|github_pat_)[A-Za-z0-9_]{10,}",
      "flags": "",
      "scope": "both"
    },
    {
      "id": "secret-aws",
      "description": "AWS access key shapes",
      "source": "\\bAKIA[0-9A-Z]{16}\\b",
      "flags": "",
      "scope": "both"
    },
    {
      "id": "secret-google",
      "description": "Google API key shapes",
      "source": "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "flags": "",
      "scope": "both"
    },
    {
      "id": "secret-slack",
