      "source": "\\bxox[bp]-[A-Za-z0-9-]{10,}",
      "flags": "",
      "scope": "both"
    },
    {
      "id": "model-suffix",
      "description": "hardware-tagged model name suffixes",
      "source": "\\b[A-Z][A-Za-z0-9]*-[LC]1\\b",
      "flags": "",
      "scope": "both"
    },
    {
      "id": "coined-product-name",
      "description": "coined product names in the retired prefix pattern",
      "source": "\\bVi[A-Z][a-z]+",
      "flags": "",
      "scope": "both"
    },
    {
      "id": "co-authored-by",
      "description": "co-author trailers in commit messages",
      "source": "^\\s*Co-authored-by:",
      "flags": "im",
      "scope": "commits"
    }
  ]
